__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.*
!.env.example

# Data lake (large, not committed). Anchored to the repo root (`/data/`, not `data/`) --
# an unanchored `data/` pattern also matched `src/data/`, the real source-code package
# (datalake/, features/, ingest/), silently excluding it from every commit since the first one.
# Confirmed via `git check-ignore -v` / `git ls-tree`: those files existed on disk (visible to
# the bind-mounted local dev container) but were never actually tracked by git, so a real
# GitHub Actions checkout never had them -- the true cause of a mypy "Cannot find implementation
# or library stub for module named src.data.datalake.query" failure that never reproduced
# locally, discovered only by comparing checked-file counts between a local mypy run (122 files)
# and the real CI log (110 files).
/data/
*.parquet
*.duckdb

# REL-007 E7.6: self-signed dev TLS CA + server cert/key, generated locally by
# scripts/generate_dev_tls_cert.py -- private key material must never be committed.
/certs/

# Test / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
coverage.json

# REL-009: local scan/test-tool output, not source -- regenerated by CI/local runs, never
# committed (module_coverage.py's own docstring: refresh CURRENT_BASELINE by hand from a real
# `measure` run's printed output, not by committing this file).
mutants/
.mutmut-cache
bandit-report.json
zap-reports/
tests/perf/results*.csv

# IDE
.vscode/
.idea/

# Node (frontend, added in Phase 4)
node_modules/
.next/

# REL-009 E9.6: real Cypress run output -- screenshots/videos/downloads are generated by every
# local/CI run, never source; cypress_output.log is this session's own ad-hoc verification
# redirect target, not a project artifact.
frontend/cypress/screenshots/
frontend/cypress/videos/
frontend/cypress/downloads/
frontend/cypress_output.log

# OS
.DS_Store
Thumbs.db

# Local logs (e.g. scripts/windows/run_daily_shadow_mode.ps1's scheduled-task output)
logs/
