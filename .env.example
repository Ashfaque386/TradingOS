# Reference only — docker-compose.yml's `app` service already sets these as container env vars
# (using in-network service hostnames: postgres/qdrant/redis) so `docker compose up` works with
# no .env file at all. Copy this to `.env` only if you need to override a value.

# Postgres
DATABASE_URL=postgresql+psycopg://tradingos:tradingos_dev_password@postgres:5432/tradingos

# Qdrant
QDRANT_URL=http://qdrant:6333

# Redis
REDIS_URL=redis://redis:6379/0

# Data lake (inside the app container)
DATA_LAKE_ROOT=/app/data/lake

# Auth: DEPRECATED as of REL-007 E7.2. JWTs are now signed/verified via Vault's Transit engine
# (src/core/vault_transit.py), not this static secret -- nothing in the app reads these two
# values anymore. Left here only as a historical record; VAULT_ADDR/VAULT_TOKEN below are what
# auth actually depends on now.
# JWT_SECRET_KEY=dev-only-change-me
# JWT_ALGORITHM=HS256

# Bootstrap SystemAdministrator user (scripts/seed_admin_user.py) - not read by the app itself,
# only by that one-time seed script. Change before running against any shared/production DB.
ADMIN_BOOTSTRAP_EMAIL=admin@tradingos.local
ADMIN_BOOTSTRAP_PASSWORD=dev-only-change-me

# Local dev Vault (docker-compose.yml `vault` service, src/core/vault.py) - dev mode only
# (in-memory storage, fixed root token). Broker credentials are read from Vault first, falling
# back to the ZERODHA_*/UPSTOX_* values below if Vault is unreachable or empty. Run
# scripts/seed_vault_broker_credentials.py after setting the broker tokens below to push them
# into Vault.
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-only-root-token

# LLM gateway (LiteLLM, Phase 2 E2.2) - see Phase_14_Master_Development_Roadmap.md §3.2.
# Ollama always runs (local, no key) - host.docker.internal resolves to the host from a container.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Every cloud provider below is optional - src/agents/llm_router.py skips any that's unset
# rather than failing. Fill in only the ones you have; leave the rest commented out.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=
# OPENCODE_API_KEY=

# LLM call tracing (NFR-05, optional) - enables litellm's LangSmith callback when set.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=tradingos

# Inbound webhook signature verification (REL-007 E7.7, SEC-025..028) - Vault-first
# (scripts/seed_vault_webhook_secrets.py), these are the .env fallback. No real bot is
# registered against any platform in this dev environment - leave unset until one is.
# TELEGRAM_WEBHOOK_SECRET=
# DISCORD_PUBLIC_KEY=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Outbound omni-channel dispatch (REL-010 E10.2, REL-026) - Vault-first
# (src/core/vault.py::write_bot_token), these are the .env fallback. No real bot/app is
# registered against any platform in this dev environment - leave unset until one is.
# TELEGRAM_BOT_TOKEN=
# DISCORD_APPLICATION_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_BUSINESS_PHONE_NUMBER_ID=

# Embedding provider for Qdrant RAG (src/memory/embeddings.py). Default "ollama" needs no key.
# Switching to huggingface/openai/gemini needs that provider's key above AND re-running
# `docker compose run --rm app python -m src.memory.collections` (dimensions differ per provider).
# EMBEDDING_PROVIDER=ollama

# Broker credentials (Phase 4 E4.1) - populated by you directly, never committed.
#
# Upstox has TWO separate app types with TWO separate token flows - don't mix them up
# (confirmed empirically: a production-flow token gets a 401 "Invalid token used to access
# API" against the sandbox host):
#
# 1. SANDBOX (UPSTOX_USE_SANDBOX=true, the default - use this for all dev/testing):
#    - Create a dedicated "Sandbox App" at https://account.upstox.com/developer/apps#sandbox
#      (NOT the regular "Create New Algo Trading App" flow - that's for production).
#    - Inside the sandbox app, click "Generate" to get an access token directly - no OAuth
#      login, no redirect URI, no `code` exchange. Valid 30 days.
#    - Base URL: https://api-sandbox.upstox.com/v2. Note: sandbox coverage is partial per
#      Upstox's own docs - order place/modify/cancel and instrument search work; portfolio/
#      funds endpoints (get_margin, get_positions) currently 404 in sandbox regardless of
#      token validity, since Upstox hasn't enabled them there yet.
#    - UPSTOX_API_KEY/UPSTOX_API_SECRET/UPSTOX_REDIRECT_URI are not needed for sandbox mode.
#
# 2. PRODUCTION (UPSTOX_USE_SANDBOX=false - real money, only once you're ready to go live):
#    - api_key/api_secret are the Client ID/Secret from a regular app at
#      https://account.upstox.com/developer/apps.
#    - Get an access_token by visiting (with your own api_key and redirect_uri filled in):
#        https://api.upstox.com/v2/login/authorization/dialog?client_id=<api_key>&redirect_uri=<redirect_uri>&response_type=code
#      logging in, then exchanging the returned `code` for a token via POST
#      https://api.upstox.com/v2/login/authorization/token. Expires daily at 3:30 AM IST (no
#      refresh token) - re-generate and re-paste it each trading day.
#
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
# UPSTOX_REDIRECT_URI=
# UPSTOX_ACCESS_TOKEN=
# UPSTOX_USE_SANDBOX=true

# Zerodha Kite Connect: a "Connect" app (paid, 500 free trial credits/30 days -- NO documented
# risk-free sandbox mode like Upstox has). api_key/api_secret come from the app you create at
# https://developers.kite.trade/apps. To get an access_token:
#   1. Visit https://kite.zerodha.com/connect/login?api_key=<api_key>&v=3 and log in.
#   2. Zerodha redirects to your ZERODHA_REDIRECT_URI with a `request_token` query param
#      (Kite's own vocabulary -- not a `code` like Upstox/most OAuth2 flows).
#   3. Exchange it via POST https://api.kite.trade/session/token with fields: api_key,
#      request_token, checksum = SHA-256(api_key + request_token + api_secret) as hex.
# Expires daily around 6 AM IST (no refresh token) -- re-generate and re-paste each trading day.
# ZERODHA_API_KEY=
# ZERODHA_API_SECRET=
# ZERODHA_REDIRECT_URI=

# REL-020 E20.2: real Slack alerting for the market-hours uptime SLO (NFR-03). An Incoming
# Webhook URL for the channel that should receive downtime alerts -- create one at
# https://api.slack.com/messaging/webhooks (pick/create a channel, "Add New Webhook"). Read by
# the grafana service (docker-compose.yml) and expanded into the alerting contact-point
# provisioning YAML via Grafana's own $__env{...} syntax -- see
# monitoring/grafana/provisioning/alerting/contact-points.yaml. Leave unset and the contact
# point simply has nowhere to send to -- Grafana logs a delivery error, nothing else breaks.
# SLACK_WEBHOOK_URL=
# ZERODHA_ACCESS_TOKEN=
